    "SOPT",
    "working memory",
    "executive function",
    "monitoring",
    "cognitive"
  ],
  "author": {
    "name": "Josh de Leeuw",
    "url": "https://github.com/jodeleeuw"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jspsych/jspsych-timelines/issues"
  },
  "homepage": "https://github.com/jspsych/jspsych-timelines/tree/main/packages/self-ordered-pointing#readme",
  "peerDependencies": {
    "jspsych": ">=8.3.0"
  },
  "devDependencies": {
    "@jspsych-timelines/testing": "*",
