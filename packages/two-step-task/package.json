  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.browser.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jspsych/jspsych-timelines.git",
    "directory": "packages/two-step-task"
  },
  "keywords": [
    "jsPsych",
    "two-step task",
    "Daw",
    "reinforcement learning",
    "model-based",
    "model-free",
    "decision making"
  ],
  "author": {
    "name": "Josh de Leeuw",
