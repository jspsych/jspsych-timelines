  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jspsych/jspsych-timelines/issues"
  },
  "homepage": "https://github.com/jspsych/jspsych-timelines/tree/main/packages/two-step-task#readme",
  "peerDependencies": {
    "jspsych": ">=8.3.0"
  },
  "devDependencies": {
    "@jspsych-timelines/testing": "*",
    "@jspsych/config": "^3.2.2",
    "jspsych": "^8.3.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@jspsych/plugin-html-button-response": "^2.1.0",
    "@jspsych/plugin-html-keyboard-response": "^2.1.0"
  }
